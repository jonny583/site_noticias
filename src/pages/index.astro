---
import Base from "../layouts/Base.astro";
import Indicadores from "../components/Indicadores.astro";
import Carrossel from "../components/Carrossel.astro";
import Grade from "../components/Grade.astro";
import ColunaDestaque from "../components/ColunaDestaque.astro";
import Newsletter from "../components/Newsletter.astro";
import JanelaNoticia from "../components/JanelaNoticia.astro";
import { noticiasPublicadas, colunas, escolherDestaques } from "../lib/conteudo";
import { gruposDoBlog } from "../lib/blog";
import { SITE } from "../config.js";
import { textos } from "../i18n";

const NA_CAPA = 24;
const t = textos();
const todas = await noticiasPublicadas();
const destaques = escolherDestaques(todas);
const feed = todas.filter((n) => !destaques.includes(n)).slice(0, NA_CAPA);
// Coluna: posts do blog; se o blog não responder, usa a coluna guardada no site
const doBlog = await gruposDoBlog(SITE.blogCapa);
const gruposColuna = doBlog.length ? doBlog : [{ nome: t.coluna, posts: (await colunas()).slice(0, 3).map((c) => ({
  titulo: c.data.titulo, resumo: c.data.resumo, data: c.data.publicadoEm, link: `/coluna/${c.id}/`, imagem: c.data.imagem,
})) }];
---
<Base compacto={false}>
  <Indicadores slot="antes" />
  <Carrossel noticias={destaques} />
  <section class="feed" aria-label={t.ultimas}>
    <div class="rotulo-secao"><h2>{t.ultimas}</h2></div>
    <Grade noticias={feed} />
    {todas.length > destaques.length + NA_CAPA && (
      <div class="ver-todas"><a class="botao" href="/arquivo/">{t.verTodas}</a></div>
    )}
  </section>
  <ColunaDestaque grupos={gruposColuna} />
  <Newsletter />
  <JanelaNoticia slot="depois" noticias={[...destaques, ...feed]} />
</Base>
