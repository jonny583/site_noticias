---
import Base from "../../layouts/Base.astro";
import Grade from "../../components/Grade.astro";
import JanelaNoticia from "../../components/JanelaNoticia.astro";
import ColunaDestaque from "../../components/ColunaDestaque.astro";
import { gruposDoBlog } from "../../lib/blog";
import { SITE } from "../../config.js";
import { CATEGORIAS, type Categoria } from "../../lib/categorias";
import { noticiasPublicadas, nomeCategoria } from "../../lib/conteudo";
import { textos } from "../../i18n";

export function getStaticPaths() {
  return CATEGORIAS.map((cat) => ({ params: { cat } }));
}
const cat = Astro.params.cat as Categoria;
const t = textos();
const nome = nomeCategoria(cat);
const lista = (await noticiasPublicadas()).filter((n) => n.data.categoria === cat).slice(0, 60);
// Posts do blog no fim da página, se esta aba tiver seções configuradas
const gruposColuna = await gruposDoBlog((SITE.blogPorEditoria as Record<string, any[]>)[cat] ?? []);
---
<Base titulo={nome} editoria={cat}>
  <div class="titulo-pagina">
    <span class="etiqueta">{t.editorias}</span>
    <h1>{nome}</h1>
    <div class="titulo-linha">
      <p>{lista.length} {lista.length === 1 ? t.noticia : t.noticias}</p>
      <div class="setas" data-setas-linha hidden>
        <span class="contador" data-contador></span>
        <button class="botao botao-icone" data-ant aria-label={t.anterior}>←</button>
        <button class="botao botao-icone" data-prox aria-label={t.proximo}>→</button>
      </div>
    </div>
  </div>
  <Grade noticias={lista} linha />
  <ColunaDestaque grupos={gruposColuna} />
  <div class="paginacao"><a class="botao" href="/">{t.voltarInicio}</a></div>
  <JanelaNoticia slot="depois" noticias={lista} />
</Base>
